# Copy to .env for local dev. On Replit, put these in Tools → Secrets (never commit real values).
ENV=dev                         # dev | prod
DATABASE_URL=sqlite:///./launchlens.db   # Replit PostgreSQL sets DATABASE_URL automatically
SECRET_KEY=change-me            # python -c "import secrets;print(secrets.token_urlsafe(48))"
FERNET_KEY=                     # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BASE_URL=http://localhost:8000
ADMIN_EMAIL=admin@launchlens.app
ADMIN_PASSWORD=                 # first-run admin password (forced change on first login)
ADMIN_NOTIFY_EMAIL=
ADMIN_RESET_PASSWORD=          # emergency admin recovery: set, restart, sign in, change password, then delete
# Shared default AI key (restricted by Admin → AI governance). Leave empty to require BYOK.
DEFAULT_ANTHROPIC_KEY=
DEFAULT_OPENAI_KEY=
DEFAULT_GOOGLE_KEY=
# Free public-data keys (raise rate limits)
OPENFDA_API_KEY=
CENSUS_API_KEY=
REGULATIONS_API_KEY=            # api.data.gov key
# Release-specific dataset IDs (override when a new release ships)
PLACES_DATASET_ID=swc5-untb
ACS_YEAR=2023
# SMTP for approval emails and password resets. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER/SMTP_FROM = your Gmail address, SMTP_PASSWORD = a 16-character Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
