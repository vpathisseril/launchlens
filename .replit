run = "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
modules = ["python-3.12"]
entrypoint = "app/main.py"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]

[[ports]]
localPort = 8000
externalPort = 80
